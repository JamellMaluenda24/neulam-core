---
import '../styles/global.css';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import { SITE, PLAY_STORE_URL, appJsonLd, orgJsonLd } from '../data/site';

const {
  title = 'Auctus — App de Hábitos, Disciplina y Productividad',
  description =
    'Auctus es la app de seguimiento de hábitos para construir disciplina diaria: rachas, rangos, XP, recordatorios inteligentes y estadísticas. Gratis en Android.',
  image = SITE.ogImage,
  noindex = false,
  jsonLd = null,
} = Astro.props;

// Canonical absoluto y sin barra final duplicada.
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// Schema.org: MobileApplication + Organization en todas las páginas,
// más el bloque específico que cada página quiera aportar (FAQPage, etc.).
const schemas = [appJsonLd, orgJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content="Neulam Core" />
  <meta name="theme-color" content="#000000" />
  <meta name="msapplication-TileColor" content="#000000" />
  <meta name="color-scheme" content="dark" />

  <!-- Open Graph -->
  <meta property="og:site_name" content="Neulam Core" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="Auctus: la app de hábitos que construye tu disciplina día a día. Gratis en Google Play." />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="Auctus: la app de hábitos que construye tu disciplina día a día. Gratis en Google Play." />

  <!-- App store association -->
  <meta name="apple-mobile-web-app-title" content="Auctus" />
  <meta name="application-name" content="Auctus" />
  <!-- Iconos optimizados (antes se servía el logo de 512×512 y ~177 KB como favicon) -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Fuentes: Roboto, la misma que la app usa en Android por ser la del
       sistema. Antes se cargaban Syne (títulos) + DM Sans (texto), que no
       aparecen en ninguna pantalla del producto. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap"
  />

  <!-- Marca la página como "con JS" cuanto antes: sin esto, el contenido animado
       quedaría en opacity:0 si el JS falla (ver global.css). -->
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- GSAP diferido: ya no bloquea el render. Los <script> de los componentes
       son módulos (defer implícito) y se ejecutan después, así que el orden se mantiene. -->
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" is:inline></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" is:inline></script>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(schemas)} />
</head>
<body>
  <a href="#main" class="skip-link">Saltar al contenido principal</a>

  <canvas id="canvas-bg" aria-hidden="true"></canvas>

  <Nav />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <script define:vars={{ PLAY_STORE_URL }}>
    // ── Red de seguridad ───────────────────────────────────────────────────
    // Si GSAP no llegó a cargar (CDN caído, bloqueador), quitamos la clase "js"
    // para que el fallback de global.css revele el contenido con opacity:0.
    if (typeof gsap === 'undefined') {
      document.documentElement.classList.remove('js');
    }

    // ── Fondo de partículas ────────────────────────────────────────────────
    // Three.js (~600 KB) ahora se carga bajo demanda: solo en escritorio y solo
    // si el usuario no pidió menos movimiento. Antes se descargaba siempre.
    (function () {
      const canvas = document.getElementById('canvas-bg');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (window.innerWidth < 768 || reduceMotion) {
        canvas.style.display = 'none';
        return;
      }

      function start() {
        const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
        renderer.setSize(window.innerWidth, window.innerHeight);
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 40;
        // Menos partículas y más tenues: el fondo debe sugerir profundidad,
        // no competir con el contenido.
        const count = 700;
        const positions = new Float32Array(count * 3);
        for (let i = 0; i < count * 3; i++) positions[i] = (Math.random() - 0.5) * 120;
        const geo = new THREE.BufferGeometry();
        geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        // Blanco, no acento: el acento significa progreso y no debe gastarse
        // en decoración de fondo (ver el sistema Mono en global.css).
        const mat = new THREE.PointsMaterial({ color: 0xFFFFFF, size: 0.12, transparent: true, opacity: 0.22 });
        const particles = new THREE.Points(geo, mat);
        scene.add(particles);
        const gridGeo = new THREE.BufferGeometry();
        const gridVerts = [];
        for (let i = -10; i <= 10; i++) {
          gridVerts.push(i * 5, -30, -60, i * 5, -30, 20);
          gridVerts.push(-60, -30, i * 5, 60, -30, i * 5);
        }
        gridGeo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(gridVerts), 3));
        const gridMat = new THREE.LineBasicMaterial({ color: 0xFFFFFF, transparent: true, opacity: 0.035 });
        scene.add(new THREE.LineSegments(gridGeo, gridMat));
        let mouse = { x: 0, y: 0 };
        document.addEventListener('mousemove', e => {
          mouse.x = (e.clientX / window.innerWidth - 0.5) * 0.3;
          mouse.y = (e.clientY / window.innerHeight - 0.5) * 0.2;
        });
        let t = 0;
        function animate() {
          requestAnimationFrame(animate);
          t += 0.003;
          particles.rotation.y = t * 0.05 + mouse.x * 0.5;
          particles.rotation.x = mouse.y * 0.3;
          camera.position.x += (mouse.x * 8 - camera.position.x) * 0.03;
          camera.position.y += (-mouse.y * 5 - camera.position.y) * 0.03;
          renderer.render(scene, camera);
        }
        animate();
        window.addEventListener('resize', () => {
          renderer.setSize(window.innerWidth, window.innerHeight);
          camera.aspect = window.innerWidth / window.innerHeight;
          camera.updateProjectionMatrix();
        });
      }

      // Se carga cuando el navegador está ocioso, fuera de la ruta crítica del LCP.
      function load() {
        const s = document.createElement('script');
        s.src = 'https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js';
        s.onload = start;
        s.onerror = () => { canvas.style.display = 'none'; };
        document.head.appendChild(s);
      }
      if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2500 });
      else window.addEventListener('load', () => setTimeout(load, 300));
    })();

    // ── Medición de conversión ─────────────────────────────────────────────
    // Deja rastro en dataLayer si algún día se conecta GA4/GTM. No carga nada.
    document.querySelectorAll('a[href^="' + PLAY_STORE_URL.slice(0, 40) + '"]').forEach(a => {
      a.addEventListener('click', () => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'play_store_click', location: a.dataset.cta || 'unknown' });
      });
    });
  </script>
</body>
</html>
