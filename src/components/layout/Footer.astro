---
import { PLAY_STORE_URL, SITE } from '../../data/site';
const year = new Date().getFullYear();
---
<style>
  footer {
    border-top: 1px solid var(--border);
    background:
      radial-gradient(ellipse at 50% 0%, rgba(53,214,255,0.05) 0%, transparent 55%),
      var(--surface);
    position: relative;
    z-index: 1;
  }
  .footer-main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 60px 56px;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 56px 40px;
  }

  /* ── Columna de marca ── */
  .footer-brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 18px;
  }
  .footer-brand-logo img { width: 34px; height: 34px; display: block; }
  .footer-brand-logo .name {
    font-family: var(--font);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: -0.4px;
    color: var(--text);
  }
  /* En muted, no en acento: el acento se reserva al progreso. */
  .footer-brand-logo .name span { color: var(--muted); }
  .footer-tagline {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
    max-width: 330px;
    margin-bottom: 24px;
  }
  .footer-store {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(53,214,255,0.08);
    border: 1px solid rgba(53,214,255,0.22);
    color: var(--accent);
    text-decoration: none;
    border-radius: 12px;
    padding: 11px 18px;
    font-size: 13.5px;
    font-weight: 500;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .footer-store:hover {
    background: rgba(53,214,255,0.14);
    border-color: rgba(53,214,255,0.42);
    transform: translateY(-2px);
  }

  /* ── Columnas de enlaces ── */
  .fcol-title {
    font-family: var(--font);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 18px;
  }
  .fcol ul { list-style: none; display: flex; flex-direction: column; gap: 11px; }
  .fcol a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease, padding-left 0.2s ease;
  }
  .fcol a:hover { color: var(--accent); padding-left: 4px; }
  .fcol a .ext { opacity: 0.55; font-size: 11px; }

  /* ── Barra inferior ── */
  .footer-bottom {
    border-top: 1px solid var(--border);
  }
  .footer-bottom-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 26px 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }
  .footer-copy {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }
  .footer-copy strong { color: var(--text); font-weight: 500; }
  .footer-copy .author { color: var(--text); font-weight: 500; }
  .footer-badges { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .fbadge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  .fbadge::before { content: '✓'; color: var(--accent); font-weight: 700; font-size: 11px; }
  .fbadge.flag::before { content: none; }

  @media (max-width: 1080px) {
    .footer-main { grid-template-columns: 1fr 1fr 1fr; gap: 44px 32px; padding: 60px 40px 48px; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-tagline { max-width: 460px; }
  }
  @media (max-width: 1080px) {
    .footer-bottom-inner { padding: 26px 40px; }
  }
  @media (max-width: 900px) {
    .footer-main { padding: 60px 24px 48px; }
    .footer-bottom-inner { padding: 24px; }
  }
  @media (max-width: 640px) {
    .footer-main { grid-template-columns: 1fr 1fr; gap: 36px 24px; }
    .footer-bottom-inner { padding: 22px 24px; flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 420px) {
    .footer-main { grid-template-columns: 1fr; padding: 48px 20px 40px; }
    .footer-bottom-inner { padding: 20px; }
    .footer-store { width: 100%; justify-content: center; }
    .footer-badges { gap: 8px; }
    .fbadge { font-size: 11px; padding: 5px 12px; }
  }
</style>

<footer>
  <div class="footer-main">

    <div class="footer-brand">
      <a href="/" class="footer-brand-logo" aria-label="Neulam Core — inicio">
        <img src="/logo.svg" alt="" width="34" height="34" loading="lazy" decoding="async" />
        <span class="name">Neulam<span>Core</span></span>
      </a>
      <p class="footer-tagline">
        Creamos herramientas de productividad y bienestar personal bien diseñadas,
        privadas y sin ruido. Auctus es nuestra app de seguimiento de hábitos.
      </p>
      <a
        href={PLAY_STORE_URL}
        target="_blank"
        rel="noopener"
        class="footer-store"
        data-cta="footer"
      >
        <svg width="16" height="18" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M48 59.49v393a4.33 4.33 0 0 0 7.37 3.07L260 256 55.37 56.42A4.33 4.33 0 0 0 48 59.49ZM345.8 174 89.22 32.64l-.16-.09c-4.42-2.4-8.62 3.58-5 7.06l201.13 192.32ZM84.08 472.39c-3.64 3.48.56 9.46 5 7.06l.16-.09L345.8 338l-60.61-57.95ZM456.9 231.21l-72.36-39.83L318.16 256l66.38 64.62 72.36-39.83a28.34 28.34 0 0 0 0-49.58Z"/>
        </svg>
        Descargar en Google Play
      </a>
    </div>

    <nav class="fcol" aria-labelledby="ft-producto">
      <p class="fcol-title" id="ft-producto">Producto</p>
      <ul>
        <li><a href="/#app">Auctus</a></li>
        <li><a href="/#why">Por qué Auctus</a></li>
        <li><a href="/#faq">Preguntas frecuentes</a></li>
        <li><a href={PLAY_STORE_URL} target="_blank" rel="noopener" data-cta="footer-links">Google Play <span class="ext">↗</span></a></li>
      </ul>
    </nav>

    <!-- Enlaces exigidos por Google Play: no cambiar estas rutas -->
    <nav class="fcol" aria-labelledby="ft-legal">
      <p class="fcol-title" id="ft-legal">Legal</p>
      <ul>
        <li><a href="/privacy">Política de privacidad</a></li>
        <li><a href="/terms">Términos y condiciones</a></li>
        <li><a href="/permissions">Permisos de la app</a></li>
        <li><a href="/delete-account">Eliminar cuenta</a></li>
      </ul>
    </nav>

    <nav class="fcol" aria-labelledby="ft-soporte">
      <p class="fcol-title" id="ft-soporte">Soporte</p>
      <ul>
        <li><a href="/#contact">Contacto</a></li>
        <li><a href={`mailto:${SITE.email}`}>Escríbenos</a></li>
        <li><a href="/#about">Sobre Neulam Core</a></li>
        <li><a href={SITE.github} target="_blank" rel="noopener">GitHub <span class="ext">↗</span></a></li>
      </ul>
    </nav>

  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner">
      <p class="footer-copy">
        © {year} <strong>Neulam Core</strong> · Diseñado y desarrollado por
        <span class="author">{SITE.author}</span>
      </p>
      <div class="footer-badges">
        <span class="fbadge">Sin anuncios</span>
        <span class="fbadge">Datos cifrados</span>
        <span class="fbadge flag">Hecho con ♥ en Chile 🇨🇱</span>
      </div>
    </div>
  </div>
</footer>
