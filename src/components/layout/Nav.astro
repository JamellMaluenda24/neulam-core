---
import { PLAY_STORE_URL } from '../../data/site';
---
<style>
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 24px 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid transparent;
    transition: all 0.3s ease;
  }
  nav.scrolled {
    background: rgba(5,8,16,0.9);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.5px;
    color: var(--text);
    text-decoration: none;
    position: relative;
    z-index: 110;
  }
  .nav-logo span { color: var(--accent); }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
    list-style: none;
  }
  @media (min-width: 1200px) { .nav-links { gap: 36px; } }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--text); }
  .nav-cta {
    background: var(--accent) !important;
    color: var(--bg) !important;
    padding: 10px 22px;
    border-radius: 100px;
    font-weight: 500 !important;
    font-size: 13px !important;
    transition: all 0.2s !important;
  }
  .nav-cta:hover { background: #fff !important; }

  /* Hamburger button */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
    position: relative;
    z-index: 110;
  }
  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
    transform-origin: center;
  }
  .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.open span:nth-child(2) { opacity: 0; width: 0; }
  .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile drawer */
  .nav-drawer {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 105;
    pointer-events: none;
  }
  .nav-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .nav-panel {
    position: absolute;
    top: 0; right: 0;
    width: min(320px, 85vw);
    height: 100%;
    background: #0f0f1a;
    border-left: 1px solid var(--border);
    padding: 100px 32px 40px;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    /* visibility evita que los enlaces del panel cerrado sigan siendo
       alcanzables con Tab fuera de pantalla. */
    visibility: hidden;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.35s;
  }
  .nav-drawer.open {
    pointer-events: all;
  }
  .nav-drawer.open .nav-backdrop { opacity: 1; }
  .nav-drawer.open .nav-panel { transform: translateX(0); visibility: visible; }

  .nav-drawer ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .nav-drawer ul li a {
    display: block;
    color: var(--muted);
    text-decoration: none;
    font-size: 17px;
    font-weight: 400;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s, padding-left 0.2s;
  }
  .nav-drawer ul li:last-child a { border-bottom: none; }
  .nav-drawer ul li a:hover { color: var(--text); padding-left: 6px; }
  .nav-drawer .drawer-cta {
    margin-top: 32px;
    background: var(--accent);
    color: var(--bg);
    padding: 14px 24px;
    border-radius: 12px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    text-align: center;
    transition: background 0.2s;
  }
  .nav-drawer .drawer-cta:hover { background: #fff; }

  /* Los seis enlaces + el CTA necesitan ~880px de ancho propio; con el padding
     de 60px la barra dejaba de caber por debajo de ~1020px y el menú se
     montaba sobre el logo. Entre 1081 y 1200 se compacta, y por debajo de
     1080 (todas las tablets) se pasa al cajón lateral. */
  @media (max-width: 1200px) {
    nav { padding: 20px 40px; }
    .nav-links { gap: 22px; }
    .nav-links a { font-size: 13px; }
    .nav-cta { padding: 9px 18px; }
  }

  @media (max-width: 1080px) {
    nav { padding: 18px 32px; }
    .nav-links { display: none; }
    .nav-burger { display: flex; }
    .nav-drawer { display: block; }
  }

  @media (max-width: 900px) {
    nav { padding: 16px 20px; }
  }

  @media (max-width: 375px) {
    nav { padding: 14px 16px; }
    .nav-logo { font-size: 18px; }
    .nav-panel { padding: 90px 24px 32px; }
  }
</style>

<nav id="navbar" aria-label="Navegación principal">
  <a href="/" class="nav-logo" aria-label="Neulam Core — inicio">Neulam<span>Core</span></a>
  <ul class="nav-links">
    <li><a href="/#app">Auctus</a></li>
    <li><a href="/#why">Por qué Auctus</a></li>
    <li><a href="/#faq">Preguntas</a></li>
    <li><a href="/#about">Nosotros</a></li>
    <li><a href="/privacy">Privacidad</a></li>
    <li><a href="/#contact">Contacto</a></li>
    <li>
      <a
        href={PLAY_STORE_URL}
        target="_blank"
        rel="noopener"
        class="nav-cta"
        data-cta="nav"
      >Descargar gratis</a>
    </li>
  </ul>
  <button
    class="nav-burger"
    id="navBurger"
    aria-label="Abrir menú de navegación"
    aria-expanded="false"
    aria-controls="navDrawer"
  >
    <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
  </button>
</nav>

<div class="nav-drawer" id="navDrawer">
  <div class="nav-backdrop" id="navBackdrop"></div>
  <div class="nav-panel" role="dialog" aria-modal="true" aria-label="Menú de navegación">
    <ul>
      <li><a href="/#app" class="drawer-link">Auctus</a></li>
      <li><a href="/#why" class="drawer-link">Por qué Auctus</a></li>
      <li><a href="/#faq" class="drawer-link">Preguntas frecuentes</a></li>
      <li><a href="/#about" class="drawer-link">Nosotros</a></li>
      <li><a href="/privacy" class="drawer-link">Privacidad</a></li>
      <li><a href="/#contact" class="drawer-link">Contacto</a></li>
    </ul>
    <a
      href={PLAY_STORE_URL}
      target="_blank"
      rel="noopener"
      class="drawer-cta"
      data-cta="drawer"
    >Descargar en Google Play →</a>
  </div>
</div>

<script>
  const burger = document.getElementById('navBurger');
  const drawer = document.getElementById('navDrawer');
  const backdrop = document.getElementById('navBackdrop');

  function toggleMenu(open) {
    burger.classList.toggle('open', open);
    drawer.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    // Estado accesible del menú para lectores de pantalla.
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    if (open) drawer.querySelector('a')?.focus();
    else burger.focus();
  }

  burger.addEventListener('click', () => toggleMenu(!drawer.classList.contains('open')));
  backdrop.addEventListener('click', () => toggleMenu(false));
  document.querySelectorAll('.drawer-link').forEach(link => {
    link.addEventListener('click', () => toggleMenu(false));
  });

  // Cerrar con Escape: requisito básico de navegación por teclado.
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) toggleMenu(false);
  });

  // El scroll dispara muy seguido; rAF evita layout thrashing (INP).
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      document.getElementById('navbar')?.classList.toggle('scrolled', window.scrollY > 40);
      ticking = false;
    });
  }, { passive: true });
</script>
