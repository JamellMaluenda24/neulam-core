---
import { testimonials } from '../../data/testimonials';

// Señales de confianza verificables: se muestran siempre, y son el contenido
// principal mientras no haya testimonios reales cargados.
const trust = [
  { icon: '🔐', title: 'Cifrado AES-256', desc: 'Tus hábitos y notas viajan y se guardan cifrados.' },
  { icon: '🚫', title: 'Cero anuncios', desc: 'Ni banners, ni vídeos, ni trackers publicitarios.' },
  { icon: '📴', title: 'Offline-first', desc: 'Funciona completa sin conexión. La nube es opcional.' },
  { icon: '🗑️', title: 'Borrado real', desc: 'Elimina tu cuenta y todos tus datos cuando quieras.' },
  { icon: '📋', title: 'Google Play', desc: 'Publicada y revisada bajo las políticas de Google Play.' },
  { icon: '🇨🇱', title: 'Indie y transparente', desc: 'Desarrollador identificable, sin empresas fantasma.' },
];
---
<style>
  .trust-section {
    padding: var(--section-y) var(--section-x);
    position: relative;
    z-index: 1;
  }
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 1000px;
    margin: 0 auto;
  }
  .trust-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 22px;
  }
  .trust-card .t-icon { font-size: 22px; line-height: 1; flex-shrink: 0; }
  .trust-card h3 {
    font-family: var(--font);
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 5px;
  }
  .trust-card p { color: var(--muted); font-size: 13px; line-height: 1.6; }

  /* Testimonios (se renderizan solo si hay reseñas reales cargadas) */
  .quotes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto 56px;
  }
  .quote-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 30px;
  }
  .quote-stars { color: var(--accent); font-size: 14px; letter-spacing: 2px; margin-bottom: 14px; }
  .quote-card blockquote { color: var(--text); font-size: 15px; line-height: 1.7; font-weight: 300; }
  .quote-author { margin-top: 18px; font-size: 13px; }
  .quote-author strong { font-family: var(--font); font-weight: 700; display: block; }
  .quote-author span { color: var(--muted); }

  @media (max-width: 1080px) {
    .trust-grid, .quotes-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .trust-section { padding: 80px 24px; }
  }
  @media (max-width: 600px) {
    .trust-grid, .quotes-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .trust-section { padding: 60px 20px; }
    .trust-card { padding: 18px; }
  }
  @media (max-width: 375px) {
    .trust-section { padding: 48px 16px; }
  }
</style>

<section class="trust-section" id="trust" aria-labelledby="trust-title">
  <div class="section-header">
    <span class="label">Confianza</span>
    <h2 id="trust-title">Una app de hábitos en la que puedes confiar</h2>
    <p>Tu rutina diaria es información personal. Así la tratamos.</p>
  </div>

  {testimonials.length > 0 && (
    <ul class="quotes-grid" role="list">
      {testimonials.map(t => (
        <li class="quote-card">
          {t.rating && (
            <div class="quote-stars" aria-label={`Valoración: ${t.rating} de 5 estrellas`}>
              <span aria-hidden="true">{'★'.repeat(t.rating)}</span>
            </div>
          )}
          <blockquote>“{t.quote}”</blockquote>
          <p class="quote-author">
            <strong>{t.author}</strong>
            {t.role && <span>{t.role}</span>}
          </p>
        </li>
      ))}
    </ul>
  )}

  <ul class="trust-grid" role="list">
    {trust.map(t => (
      <li class="trust-card">
        <span class="t-icon" aria-hidden="true">{t.icon}</span>
        <div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
