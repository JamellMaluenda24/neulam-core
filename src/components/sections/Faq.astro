---
import { faqs } from '../../data/faq';
---
<style>
  .faq {
    padding: 140px 60px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 1;
  }
  .faq-inner { max-width: 820px; margin: 0 auto; }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }
  .faq-item:first-child { border-top: 1px solid var(--border); }

  .faq-item summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    transition: color 0.2s;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--accent); }

  .faq-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    position: relative;
    margin-top: 2px;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--accent);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .faq-icon::before { top: 10px; left: 3px; width: 16px; height: 2px; }
  .faq-icon::after  { top: 3px; left: 10px; width: 2px; height: 16px; }
  .faq-item[open] .faq-icon::after { transform: rotate(90deg); opacity: 0; }

  .faq-answer {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
    padding: 0 42px 24px 0;
    margin-top: -4px;
  }

  .faq-foot {
    margin-top: 40px;
    text-align: center;
    color: var(--muted);
    font-size: 15px;
  }
  .faq-foot a { color: var(--accent); text-decoration: none; font-weight: 500; }
  .faq-foot a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .faq { padding: 80px 24px; }
  }
  @media (max-width: 480px) {
    .faq { padding: 60px 20px; }
    .faq-item summary { font-size: 15px; padding: 18px 0; gap: 14px; }
    .faq-answer { font-size: 14px; padding-right: 0; padding-bottom: 20px; }
  }
  @media (max-width: 375px) {
    .faq { padding: 48px 16px; }
    .faq-item summary { font-size: 14px; }
  }
</style>

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="faq-inner">
    <div class="section-header">
      <span class="label">Preguntas frecuentes</span>
      <h2 id="faq-title">Todo sobre Auctus, tu app de hábitos</h2>
      <p>Lo que más nos preguntan sobre el seguimiento de hábitos, el Premium y la privacidad.</p>
    </div>

    {faqs.map(item => (
      <details class="faq-item">
        <summary>
          <span>{item.q}</span>
          <span class="faq-icon" aria-hidden="true"></span>
        </summary>
        <p class="faq-answer">{item.a}</p>
      </details>
    ))}

    <p class="faq-foot">
      ¿Te quedó otra duda? <a href="#contact">Escríbenos</a> o revisa la
      <a href="/privacy">política de privacidad</a>.
    </p>
  </div>
</section>
