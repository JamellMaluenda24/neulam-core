---
import PlayStoreButton from '../ui/PlayStoreButton.astro';

// Diferenciadores verificables frente a otras apps de hábitos.
const reasons = [
  {
    icon: '🎯',
    title: 'Diseñada para la disciplina, no para la motivación',
    desc: 'La motivación se agota en tres días. Auctus construye consistencia con rachas, rangos y XP que premian aparecer todos los días, no solo los buenos.',
  },
  {
    icon: '🛡️',
    title: 'Un mal día no borra tu progreso',
    desc: 'Los escudos de racha y el pase de vacaciones protegen semanas de esfuerzo. Otras apps de hábitos te castigan por vivir; esta no.',
  },
  {
    icon: '📊',
    title: 'Estadísticas que sí dicen algo',
    desc: 'Discipline Score, tendencias, correlaciones entre ánimo y hábitos, y proyecciones. Insights personalizados en vez de gráficos decorativos.',
  },
  {
    icon: '🔒',
    title: 'Tus datos son tuyos',
    desc: 'Offline-first con cifrado AES-256 en tu dispositivo. Sin anuncios, sin venta de datos y con eliminación de cuenta en un toque.',
  },
  {
    icon: '⏰',
    title: 'Recordatorios inteligentes',
    desc: 'Avisos por hábito y franja horaria que llegan cuando de verdad puedes cumplirlos, no cuando ya es tarde.',
  },
  {
    icon: '⚡',
    title: 'Rápida y sin fricción',
    desc: 'Marcar el día toma un toque. Funciona sin conexión y sincroniza sola en segundo plano cuando vuelve el internet.',
  },
];
---
<style>
  .why {
    padding: var(--section-y) var(--section-x);
    position: relative;
    z-index: 1;
    background: radial-gradient(ellipse at 50% 100%, rgba(0,212,200,0.04) 0%, transparent 60%);
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .why-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 32px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .why-card:hover {
    transform: translateY(-4px);
    border-color: rgba(0,212,200,0.2);
  }
  .why-card .why-icon { font-size: 28px; display: block; margin-bottom: 16px; }
  .why-card h3 {
    font-family: 'Syne', sans-serif;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  .why-card p { color: var(--muted); font-size: 14px; line-height: 1.7; }

  .why-cta {
    max-width: 1100px;
    margin: 56px auto 0;
    text-align: center;
  }
  .why-cta p {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 24px;
  }

  @media (max-width: 1080px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 900px) {
    .why { padding: 80px 24px; }
    .why-card { padding: 26px; }
  }
  @media (max-width: 600px) {
    .why-grid { grid-template-columns: 1fr; gap: 16px; }
    .why-card { padding: 24px; border-radius: 16px; }
  }
  @media (max-width: 480px) {
    .why { padding: 60px 20px; }
    .why-cta { margin-top: 36px; }
  }
  @media (max-width: 375px) {
    .why { padding: 48px 16px; }
    .why-card { padding: 20px; }
  }
</style>

<section class="why" id="why" aria-labelledby="why-title">
  <div class="section-header">
    <span class="label">Por qué elegir Auctus</span>
    <h2 id="why-title">La app de hábitos para quien va en serio</h2>
    <p>
      Hay muchas aplicaciones de productividad. Estas son las seis razones por las que
      quienes buscan disciplina diaria y crecimiento personal se quedan en Auctus.
    </p>
  </div>

  <ul class="why-grid" role="list">
    {reasons.map(r => (
      <li class="why-card">
        <span class="why-icon" aria-hidden="true">{r.icon}</span>
        <h3>{r.title}</h3>
        <p>{r.desc}</p>
      </li>
    ))}
  </ul>

  <div class="why-cta">
    <p>Empieza hoy tu primera racha. Gratis, sin tarjeta y sin anuncios.</p>
    <PlayStoreButton location="why" />
  </div>
</section>
