---
import PlayStoreButton from '../ui/PlayStoreButton.astro';
---
<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 40px 80px;
    position: relative;
  }
  .hero-inner { max-width: 900px; }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0,212,200,0.08);
    border: 1px solid rgba(0,212,200,0.2);
    color: var(--accent);
    padding: 7px 16px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 40px;
    opacity: 0;
  }
  .hero-badge::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse-dot 2s infinite;
  }
  .hero h1 {
    font-family: 'Syne', sans-serif;
    font-size: clamp(52px, 8vw, 100px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -3px;
    margin-bottom: 32px;
    /* Sin opacity:0 a propósito: el h1 es el elemento LCP. Si esperara a GSAP
       (que ahora carga diferido) el LCP se retrasaría cientos de ms. */
  }
  .hero h1 em {
    font-style: normal;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255,255,255,0.3);
  }
  .hero h1 .accent-word { color: var(--accent); }
  .hero-sub {
    font-size: 18px;
    color: var(--muted);
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 48px;
    font-weight: 300;
    opacity: 0;
  }
  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    align-items: center;
    opacity: 0;
    flex-wrap: wrap;
    width: 100%;
    max-width: 460px;
    margin-left: auto;
    margin-right: auto;
  }
  /* Señales de confianza bajo el CTA */
  .hero-trust {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 28px;
    list-style: none;
    font-size: 13px;
    color: var(--muted);
  }
  .hero-trust li { display: inline-flex; align-items: center; gap: 6px; }
  .hero-trust li::before { content: '✓'; color: var(--accent); font-weight: 700; }
  .freemium-note {
    width: 100%;
    text-align: center;
    font-size: 12px;
    color: var(--muted);
    margin-top: 4px;
    letter-spacing: 0.03em;
  }
  .freemium-note span { color: var(--accent); font-weight: 500; }
  .orb1 {
    position: absolute;
    top: 30%; left: 10%;
    width: 400px; height: 400px;
    background: rgba(0,212,200,0.05);
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
  }
  .orb2 {
    position: absolute;
    top: 20%; right: 5%;
    width: 300px; height: 300px;
    background: rgba(0,181,170,0.06);
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero { padding: 100px 24px 60px; }
    .hero h1 { letter-spacing: -2px; margin-bottom: 24px; }
    .hero-sub { font-size: 16px; margin-bottom: 36px; }
    .hero-actions { gap: 12px; max-width: 340px; }
    .orb1 { width: 250px; height: 250px; top: 20%; left: -5%; }
    .orb2 { width: 200px; height: 200px; top: 10%; right: -5%; }
    .freemium-note { font-size: 11px; }
  }

  @media (max-width: 480px) {
    .hero { padding: 90px 20px 60px; }
    .hero-inner { width: 100%; }
    .hero h1 { letter-spacing: -1.5px; }
    .hero-sub { font-size: 15px; margin-bottom: 28px; }
    .hero-actions { max-width: 100%; gap: 10px; }
    .hero-trust { font-size: 12px; gap: 6px 14px; margin-top: 20px; }
    .btn-store { width: 100%; justify-content: center; }
    .hero-scroll { display: none; }
    .hero-badge { font-size: 11px; padding: 6px 12px; margin-bottom: 28px; }
  }

  @media (max-width: 375px) {
    .hero { padding: 80px 16px 50px; }
    .hero h1 { font-size: 44px; letter-spacing: -1px; }
    .hero-sub { font-size: 14px; }
  }
</style>

<section class="hero" aria-labelledby="hero-title">
  <div class="orb1" aria-hidden="true"></div>
  <div class="orb2" aria-hidden="true"></div>
  <div class="hero-inner">
    <p class="hero-badge">App de hábitos · Android · Gratis</p>
    <h1 id="hero-title">
      La app de hábitos<br>
      que construye tu <span class="accent-word">disciplina</span><br>
      <em>día a día.</em>
    </h1>
    <p class="hero-sub">
      <strong style="color:var(--text);font-weight:500;">Auctus</strong> —del latín <em style="color:var(--text);">crecimiento</em>— es un
      <strong style="color:var(--text);font-weight:400;">habit tracker</strong> para quienes se toman en serio su desarrollo personal.
      Sigue tus hábitos diarios, protege tus rachas, sube de rango y mide tu progreso con estadísticas reales.
      <span style="color:var(--text);font-weight:400;">Gratis para empezar.</span>
    </p>
    <div class="hero-actions">
      <PlayStoreButton location="hero" />
      <p class="freemium-note"><span>Gratis</span> para siempre · Desbloquea más con <span>Premium</span></p>
    </div>
    <ul class="hero-trust">
      <li>Funciona sin conexión</li>
      <li>Sin anuncios</li>
      <li>Datos cifrados AES-256</li>
      <li>Hecho en Chile 🇨🇱</li>
    </ul>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<script>
  if (typeof gsap !== 'undefined') {
    gsap.registerPlugin(ScrollTrigger);
    const tl = gsap.timeline({ delay: 0.15 });
    tl.to('.hero-badge', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' })
      .to('.hero-sub', { opacity: 1, y: 0, duration: 0.7, ease: 'power2.out' }, '-=0.35')
      .to('.hero-actions', { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '-=0.4');

    gsap.to('.hero h1', {
      scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1 },
      y: 80
    });
  }
</script>
